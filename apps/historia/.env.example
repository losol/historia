# This file is an example of a .env file for the historia app.

# Set up your database
CMS_DATABASE_URL=postgres://127.0.0.1:5432/cms

CMS_ALLOWED_ORIGINS=http://localhost:3100

# Make your secret with `openssl rand -hex 64`
CMS_SECRET=SECRET_HERE

# Encrypts the visitor session cookie that holds the cart. Without it every cart
# action fails, so the server refuses to start in production without it.
# 32 bytes as hex (64 characters):
#   openssl rand -hex 32
SESSION_SECRET=SESSION_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
# Must be HTTPS for Vipps - use Cloudflare tunnel for local dev:
# cloudflared tunnel --url http://localhost:3100
NEXT_PUBLIC_CMS_URL=http://localhost:3000

# Set up localisation
NEXT_PUBLIC_CMS_LOCALES=nb,en
NEXT_PUBLIC_CMS_DEFAULT_LOCALE=nb

PREVIEW_SECRET=your-preview-secret-here

# Push database changes automatically in development
HISTORIA_DB_DEV_PUSH=true

# VIPPS PAYMENT CONFIGURATION
VIPPS_API_URL=https://apitest.vipps.no
VIPPS_MERCHANT_SERIAL_NUMBER=123
VIPPS_CLIENT_ID=123
VIPPS_CLIENT_SECRET=SECRET
VIPPS_SUBSCRIPTION_KEY=123

# VIPPS LOGIN CONFIGURATION
# Separate credentials for Vipps Login (different from ePayment)
# Must be exactly 'true' to turn Vipps Login on: the auth strategy, the
# /api/auth/vipps/* routes (404 otherwise) and the button on the admin login.
VIPPS_LOGIN_ENABLED=false
# Environment: 'test' or 'production' (default: test)
VIPPS_LOGIN_CLIENT_ID=your-login-client-id
VIPPS_LOGIN_CLIENT_SECRET=your-login-client-secret

# 'false' turns email and password login off, so an identity provider (OIDC or
# Vipps) is the only way in: the login page shows only its button, and login,
# forgot-password and reset-password answer 403. Ignored, with an error in the
# log, unless one of them is enabled. Break-glass: set it back to true and
# restart; existing users keep their passwords. See docs/OIDC_LOGIN_SETUP.md.
PASSWORD_LOGIN_ENABLED=true

# Login through an OpenID Connect provider such as Keycloak (Tessera). Must be
# exactly 'true' to turn it on: the auth strategy, the /api/auth/oidc/* routes
# and the button on the admin login. Register <public origin>/api/auth/oidc/callback
# as a redirect URI with the provider.
OIDC_LOGIN_ENABLED=false
# The issuer, where .well-known/openid-configuration is found. For Keycloak:
# https://<host>/realms/<realm>
OIDC_ISSUER=https://idp.example.com/realms/example
OIDC_CLIENT_ID=historia
OIDC_CLIENT_SECRET=your-client-secret
# 'false' lets only people who already have a user in. Default: new users are
# created, without roles, so they see nothing until an admin grants access.
OIDC_ALLOW_SIGNUP=true
# The button on the admin login (default: "Logg inn").
OIDC_LOGIN_LABEL=Logg inn med Tessera
# The provider's role that makes a user a system admin. Set, the provider is the
# source of the global roles: every login sets them from its claims, and a role
# it does not send is taken away. Unset: roles are granted by hand in the admin.
# OIDC_SYSTEM_ADMIN_ROLE=historia-admin
# Where the roles are in the userinfo (default: realm_access.roles; client roles
# are under resource_access.<client id>.roles). Keycloak sends them only when the
# role mapper has "Add to userinfo" on. See docs/OIDC_LOGIN_SETUP.md.
# OIDC_ROLES_CLAIM=realm_access.roles

# Set up S3 for media storage
CMS_MEDIA_S3_ACCESS_KEY_ID=ACCESS_KEY_ID_HERE
CMS_MEDIA_S3_ENDPOINT=ENDPOINT_HERE
CMS_MEDIA_S3_SECRET_ACCESS_KEY=SECRET
CMS_MEDIA_S3_REGION=REGION_HERE
CMS_MEDIA_S3_BUCKET=BUCKET_HERE

# Email Configuration (SMTP)
# Set FEATURE_SMTP=enabled to send real emails, otherwise emails are logged to console
FEATURE_SMTP=disabled
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-password
SMTP_FROM_EMAIL=noreply@eventuras.com
SMTP_FROM_NAME=Historia

# Sentry Error Tracking
# Read at runtime, so the same image can report to any Sentry project, or none.
# Sentry is on when SENTRY_DSN is set. Check with /api/sentry-check (system admins).
SENTRY_DSN=
# e.g. staging or production
SENTRY_ENVIRONMENT=development
# Let Sentry send personal data such as IP addresses
SENTRY_SEND_DEFAULT_PII=false
# Build time only: upload source maps for readable stack traces
SENTRY_AUTH_TOKEN=your-auth-token
CMS_SENTRY_ORG=your-org
CMS_SENTRY_PROJECT=your-project
