{
  "name": "historia",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r build",
    "changeset": "changeset",
    "changeset:tag": "changeset tag",
    "changeset:version": "changeset version",
    "dev": "pnpm --filter @eventuras/historia dev",
    "lint": "pnpm -r lint",
    "release": "changeset version && git add . && git commit -m 'chore: version packages' && changeset tag && git push --follow-tags",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1"
  },
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=11.0.0"
  }
}
