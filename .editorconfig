# http://EditorConfig.org

# This file is the top-most EditorConfig file
root = true

# Biome owns formatting for the languages it supports — js, jsx, ts, tsx, json,
# jsonc and css — and biome.jsonc is the only source of truth for those. See
# .vscode/settings.json for the editor wiring. What is left here is the baseline
# for the file types Biome does not format (md, yaml, scss) and for editors and
# tools that read .editorconfig but not biome.jsonc.

# All Files
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
max_line_length = 0
trim_trailing_whitespace = false

[.changeset/**]
generated_code = true

[**/CHANGELOG.md]
generated_code = true

[**/migrations/**]
generated_code = true
