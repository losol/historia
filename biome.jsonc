{
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      // Generated by Payload / Next / changesets — never format these.
      "!**/payload-types.ts",
      "!**/next-env.d.ts",
      "!**/CHANGELOG.md",
      "!pnpm-lock.yaml",
      "!**/migrations",
      // Next.js rewrites tsconfig.json on build, so formatting it causes
      // endless churn. It was excluded in the old .prettierignore too.
      "!**/tsconfig.json",
      // Build artefacts.
      "!**/.next",
      "!**/dist",
      "!**/build",
      "!**/out",
      "!**/coverage",
      "!**/test-results",
      "!**/playwright-report",
      "!docs"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "css": {
    "parser": {
      // globals.css uses Tailwind 4 directives (@import, @config, @theme).
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "next": "recommended",
      "react": "recommended"
    },
    "rules": {
      "preset": "recommended",

      // ── Migration baseline ──────────────────────────────────────────
      // The rules below are still violated by existing code and are set to
      // "warn" so `biome ci` stays green. Be aware of what that costs:
      // `biome ci` exits 0 on warnings, so these rules are NOT enforced —
      // a new `any` or `!` lands without CI objecting.
      //
      // Counts are current as of 2026-09-24. Burn a rule down to zero, then
      // drop its line. Careful: dropping a line restores the rule's default
      // severity in the recommended preset, and that default is only "warn"
      // for some rules, so check with `biome explain <rule>` before assuming
      // CI will gate it — pin it to "error" below if not.
      // When this list is empty, `biome ci --error-on-warnings` replaces
      // `biome ci` and the distinction stops mattering.
      "style": {
        // Cleared; pinned above its "warn" default so CI rejects new ones.
        "noNonNullAssertion": "error"
      },
      "suspicious": {
        "noExplicitAny": "warn" // 12
      },
      "performance": {
        // InstructionBlock renders a plain <img>. <Media> would work, but it
        // replaces the alt text with the media description, so it is not a
        // drop-in swap.
        "noImgElement": "warn", // 1

        // ── Cleared, pinned above their "warn" default ──
        "noAccumulatingSpread": "error"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedFunctionParameters": "error",
        "noUnusedVariables": "error"
      },
      "complexity": {
        "useDateNow": "error"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            // Mirrors the simple-import-sort groups from @eventuras/eslint-config.
            "groups": [
              ":NODE:",
              ["react", "react-*"],
              "@eventuras/**",
              ":PACKAGE:",
              ":ALIAS:",
              ":PATH:",
              ":STYLE:"
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      // Email clients override anchor colours aggressively — Gmail and Outlook
      // will recolour the tracking button's text unless the rule is marked
      // `!important`. Biome flags that as noImportantStyles, but removing it
      // here renders white-on-green as the client's default link blue. This is
      // a deliberate exception, not a violation left to burn down.
      "includes": ["packages/notitia-templates/*.html"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    }
  ]
}
