{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      // Generated by Payload / Next / changesets — never format these.
      "!**/payload-types.ts",
      "!**/next-env.d.ts",
      "!**/CHANGELOG.md",
      "!pnpm-lock.yaml",
      "!**/migrations",
      // Next.js rewrites tsconfig.json on build, so formatting it causes
      // endless churn. It was excluded in the old .prettierignore too.
      "!**/tsconfig.json",
      // Build artefacts.
      "!**/.next",
      "!**/dist",
      "!**/build",
      "!**/out",
      "!**/coverage",
      "!**/test-results",
      "!**/playwright-report",
      "!docs"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "css": {
    "parser": {
      // globals.css uses Tailwind 4 directives (@import, @config, @theme).
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "next": "recommended",
      "react": "recommended"
    },
    "rules": {
      "preset": "recommended",

      // ── Migration baseline ──────────────────────────────────────────
      // The rules below are already violated by existing code. They are
      // set to "warn" so `biome ci` is green at migration time and can
      // still fail on new violations elsewhere in the recommended set.
      // The number is the hit count when Biome was introduced — these are
      // meant to be burned down and the line removed, not kept forever.
      "style": {
        "noNonNullAssertion": "warn" // 107
      },
      "suspicious": {
        "noExplicitAny": "warn", // 71
        "noImplicitAnyLet": "warn", // 9
        "noArrayIndexKey": "warn", // 5
        "useIterableCallbackReturn": "warn" // 3 — forEach(() => console.error(…)) in dev scripts
      },
      "correctness": {
        "noUnusedImports": "warn", // 21 — dead code, fix with `biome check --write --unsafe`
        "useExhaustiveDependencies": "warn", // 17 — was a warning under ESLint as well
        "noUnusedFunctionParameters": "warn", // 7
        "noUnusedVariables": "warn" // 2
      },
      "security": {
        "noDangerouslySetInnerHtml": "warn" // 4 — deliberate when rendering CMS content
      },
      "a11y": {
        "noSvgWithoutTitle": "warn", // 3
        "noLabelWithoutControl": "warn", // 1
        "useButtonType": "warn", // 1
        "noRedundantRoles": "warn", // 1
        "useHtmlLang": "warn" // 1 — example-order-shipped-email.html
      },
      "performance": {
        "noAccumulatingSpread": "warn", // 2
        "noImgElement": "warn" // 1
      },
      "complexity": {
        "useDateNow": "warn", // 2
        "noImportantStyles": "warn" // 1
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            // Mirrors the simple-import-sort groups from @eventuras/eslint-config.
            "groups": [
              ":NODE:",
              ["react", "react-*"],
              "@eventuras/**",
              ":PACKAGE:",
              ":ALIAS:",
              ":PATH:",
              ":STYLE:"
            ]
          }
        }
      }
    }
  }
}
