{
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      // Generated by Payload / Next / changesets — never format these.
      "!**/payload-types.ts",
      "!**/next-env.d.ts",
      "!**/CHANGELOG.md",
      "!pnpm-lock.yaml",
      "!**/migrations",
      // Next.js rewrites tsconfig.json on build, so formatting it causes
      // endless churn. It was excluded in the old .prettierignore too.
      "!**/tsconfig.json",
      // Build artefacts.
      "!**/.next",
      "!**/dist",
      "!**/build",
      "!**/out",
      "!**/coverage",
      "!**/test-results",
      "!**/playwright-report",
      "!docs"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "css": {
    "parser": {
      // globals.css uses Tailwind 4 directives (@import, @config, @theme).
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "next": "recommended",
      "react": "recommended"
    },
    "rules": {
      // CI runs `biome ci --error-on-warnings` (as does `pnpm lint`), so every
      // rule in the preset is enforced, including the ones that only default to
      // "warn" (noExplicitAny, noNonNullAssertion, noUnusedImports, …).
      // Deliberate exceptions are made inline with a `biome-ignore` comment that
      // says why, next to the code they cover.
      "preset": "recommended"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            // Mirrors the simple-import-sort groups from @eventuras/eslint-config.
            "groups": [
              ":NODE:",
              ["react", "react-*"],
              "@eventuras/**",
              ":PACKAGE:",
              ":ALIAS:",
              ":PATH:",
              ":STYLE:"
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      // Email clients override anchor colours aggressively — Gmail and Outlook
      // will recolour the tracking button's text unless the rule is marked
      // `!important`. Biome flags that as noImportantStyles, but removing it
      // here renders white-on-green as the client's default link blue. This is
      // a deliberate exception, not a violation left to burn down.
      "includes": ["packages/notitia-templates/*.html"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    },
    {
      // The app logs through @eventuras/logger. The startup banner in
      // logStartupConfig.ts is the one place that prints to the console on
      // purpose.
      "includes": ["apps/historia/src/**", "!apps/historia/src/utilities/logStartupConfig.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "error"
          }
        }
      }
    }
  ]
}
