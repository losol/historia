{
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      // Generated by Payload / Next / changesets — never format these.
      "!**/payload-types.ts",
      "!**/next-env.d.ts",
      "!**/CHANGELOG.md",
      "!pnpm-lock.yaml",
      "!**/migrations",
      // Next.js rewrites tsconfig.json on build, so formatting it causes
      // endless churn. It was excluded in the old .prettierignore too.
      "!**/tsconfig.json",
      // Build artefacts.
      "!**/.next",
      "!**/dist",
      "!**/build",
      "!**/out",
      "!**/coverage",
      "!**/test-results",
      "!**/playwright-report",
      "!docs"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "css": {
    "parser": {
      // globals.css uses Tailwind 4 directives (@import, @config, @theme).
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "next": "recommended",
      "react": "recommended"
    },
    "rules": {
      "preset": "recommended",

      // ── Migration baseline ──────────────────────────────────────────
      // The rules below are still violated by existing code and are set to
      // "warn" so `biome ci` stays green. Be aware of what that costs:
      // `biome ci` exits 0 on warnings, so these rules are NOT enforced —
      // a new `any` or `!` lands without CI objecting.
      //
      // Counts are current as of 2026-09-23. Burn a rule down to zero, then
      // drop its line. Careful: dropping a line restores the rule's default
      // severity in the recommended preset, and that default is only "warn"
      // for some rules (noUnusedImports and useDateNow are both "warn"), so
      // check before assuming CI will gate it — pin it to "error" if not.
      // When this list is empty, `biome ci --error-on-warnings` replaces
      // `biome ci` and the distinction stops mattering.
      "style": {
        "noNonNullAssertion": "warn" // 95
      },
      "suspicious": {
        "noExplicitAny": "warn", // 68
        "noImplicitAnyLet": "warn", // 9
        "noArrayIndexKey": "warn", // 5
        "useIterableCallbackReturn": "warn" // 3 — forEach(() => console.error(…)) in dev scripts
      },
      "correctness": {
        // Cleared by the mechanical sweep and pinned above its "warn" default
        // so it cannot creep back in unnoticed.
        "noUnusedImports": "error",

        // These autofixes edit React dependency arrays or rename bindings to
        // `_foo`, so they are deliberately excluded from the mechanical sweep.
        // Tried once: Biome dropped `pathname` from a Header effect's deps,
        // which stops the effect re-running on navigation. Fix these by hand.
        "useExhaustiveDependencies": "warn", // 3
        "noUnusedFunctionParameters": "warn", // 6
        "noUnusedVariables": "warn" // 2
      },
      "security": {
        "noDangerouslySetInnerHtml": "warn" // 4 — deliberate when rendering CMS content
      },
      "a11y": {
        "noSvgWithoutTitle": "warn", // 3
        "noLabelWithoutControl": "warn", // 1
        "useButtonType": "warn", // 1
        "useHtmlLang": "warn" // 1 — example-order-shipped-email.html
      },
      "performance": {
        "noAccumulatingSpread": "warn", // 2
        "noImgElement": "warn" // 1
      },
      "complexity": {
        // Also cleared, also only "warn" by default. noImportantStyles and
        // a11y/noRedundantRoles were cleared too but default to "error", so
        // they need no line here.
        "useDateNow": "error"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            // Mirrors the simple-import-sort groups from @eventuras/eslint-config.
            "groups": [
              ":NODE:",
              ["react", "react-*"],
              "@eventuras/**",
              ":PACKAGE:",
              ":ALIAS:",
              ":PATH:",
              ":STYLE:"
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      // Email clients override anchor colours aggressively — Gmail and Outlook
      // will recolour the tracking button's text unless the rule is marked
      // `!important`. Biome flags that as noImportantStyles, but removing it
      // here renders white-on-green as the client's default link blue. This is
      // a deliberate exception, not a violation left to burn down.
      "includes": ["packages/notitia-templates/*.html"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    }
  ]
}
