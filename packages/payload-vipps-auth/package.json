{
  "name": "@eventuras/payload-vipps-auth",
  "version": "0.3.0",
  "private": true,
  "description": "Vipps Login provider for @eventuras/payload-oidc-auth",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "dev": "vite build --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@eventuras/fides-auth": "^0.14.1",
    "@eventuras/payload-oidc-auth": "workspace:*",
    "@eventuras/vipps": "workspace:*"
  },
  "devDependencies": {
    "@eventuras/typescript-config": "^1.1.1",
    "@eventuras/vite-config": "^0.5.0",
    "@types/node": "^24.12.0",
    "@types/react": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "payload": "3.90.2",
    "react": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "payload": "^3.0.0"
  }
}
