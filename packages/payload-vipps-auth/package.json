{
  "name": "@eventuras/payload-vipps-auth",
  "version": "0.1.11",
  "private": true,
  "description": "Vipps Login authentication plugin for Payload CMS",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
