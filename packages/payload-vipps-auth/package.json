    "@payloadcms/next": "3.88.0",
    "@types/node": "^24.12.0",
    "@types/react": "^19.3.0",
    "@types/uuid": "^11.0.0",
    "next": "^16.3.5",
    "payload": "3.89.0",
    "react": "^19.3.0",
    "typescript": "^6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@payloadcms/next": "^3.0.0",
