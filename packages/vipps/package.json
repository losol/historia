{
  "name": "@eventuras/vipps",
  "version": "0.2.10",
  "private": true,
  "description": "Vipps MobilePay integration for Eventuras",
  "type": "module",
  "exports": {
    "./epayment-v1": {
      "types": "./dist/epayment-v1/index.d.ts",
      "import": "./dist/epayment-v1/index.js"
    },
    "./vipps-core": {
      "types": "./dist/vipps-core/index.d.ts",
      "import": "./dist/vipps-core/index.js"
    },
    "./webhooks-v1": {
      "types": "./dist/webhooks-v1/index.d.ts",
      "import": "./dist/webhooks-v1/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "payment:get": "tsx --env-file=.env scripts/get-payment.ts",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "webhook:delete": "tsx --env-file=.env scripts/delete-webhook.ts",
    "webhook:list": "tsx --env-file=.env scripts/list-webhooks.ts",
    "webhook:setup": "tsx --env-file=.env scripts/setup-webhook.ts"
  },
  "dependencies": {
    "@eventuras/fides-auth": "^0.14.0",
    "@eventuras/logger": "^0.8.1",
    "openid-client": "^6.8.6"
  },
  "devDependencies": {
    "@eventuras/typescript-config": "^1.0.0",
    "@eventuras/vite-config": "^0.3.1",
    "@vitest/ui": "^4.1.11",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
