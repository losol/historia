{
  "name": "@eventuras/payload-seo",
  "version": "0.1.0",
  "private": true,
  "description": "SEO meta fields for Payload CMS collections",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm run clean && vite build",
    "clean": "rm -rf dist",
    "dev": "vite build --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@eventuras/typescript-config": "^1.0.0",
    "@eventuras/vite-config": "^0.3.1",
    "payload": "3.88.0",
    "typescript": "^6.0.2",
    "vite": "^8.2.1"
  },
  "peerDependencies": {
    "payload": "^3.0.0"
  },
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  }
}
