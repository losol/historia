{
  "name": "@eventuras/notitia-templates",
  "version": "0.2.4",
  "private": true,
  "description": "Handlebars-based library for generating SMS and email texts with support for default templates and custom overrides",
  "keywords": [
    "templates",
    "handlebars",
    "email",
    "sms",
    "notifications",
    "eventuras"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/losol/eventuras.git",
    "directory": "libs/notitia-templates"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm run clean && vite build && tsc --emitDeclarationOnly",
    "clean": "rm -rf dist",
    "dev": "vite build --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "handlebars": "^4.7.9"
  },
  "devDependencies": {
    "@eventuras/typescript-config": "^1.1.0",
    "@eventuras/vite-config": "^0.4.0",
    "@types/handlebars": "^4.1.0",
    "@types/node": "^24.12.0",
    "@typescript/typescript6": "^6.0.2",
    "tslib": "2.8.1",
    "typescript": "^7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  }
}
