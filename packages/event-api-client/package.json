{
  "name": "@eventuras/event-api-client",
  "version": "0.1.0",
  "private": true,
  "description": "A client for the public Eventuras event API: list events, read one",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "dev": "vite build --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@eventuras/logger": "^0.9.2"
  },
  "devDependencies": {
    "@eventuras/typescript-config": "^1.1.1",
    "@eventuras/vite-config": "^0.5.0",
    "@types/node": "^24.12.0",
    "@typescript/typescript6": "^6.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
