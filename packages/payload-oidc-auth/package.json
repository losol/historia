{
  "name": "@eventuras/payload-oidc-auth",
  "version": "0.1.0",
  "private": true,
  "description": "OpenID Connect login for Payload CMS, with one plugin for any number of providers",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "dev": "vite build --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@eventuras/fides-auth": "^0.14.1",
    "@eventuras/logger": "^0.9.2",
    "openid-client": "^6.8.8",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@eventuras/typescript-config": "^1.1.1",
    "@eventuras/vite-config": "^0.5.0",
    "@types/node": "^24.12.0",
    "@types/react": "^19.3.0",
    "@types/uuid": "^11.0.0",
    "@typescript/typescript6": "^6.0.2",
    "payload": "3.90.2",
    "react": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "payload": "^3.0.0"
  }
}
