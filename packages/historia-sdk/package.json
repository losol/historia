{
  "name": "@eventuras/historia-sdk",
  "version": "0.0.1",
  "description": "Small client for reading Historia content, such as products, from other sites",
  "keywords": [
    "historia",
    "cms",
    "sdk",
    "products"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/losol/historia.git",
    "directory": "packages/historia-sdk"
  },
  "homepage": "https://github.com/losol/historia/tree/main/packages/historia-sdk#readme",
  "type": "module",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "dev": "vite build --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "devDependencies": {
    "@eventuras/typescript-config": "^1.1.0",
    "@eventuras/vite-config": "^0.4.0",
    "@typescript/typescript6": "^6.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
